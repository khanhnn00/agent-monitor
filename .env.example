# Name shown for this machine on the usage page
MACHINE_NAME=macbook-1
# Shared secret for machine → hub reports; same value on every machine
HUB_TOKEN=change-me
# Hub machine: leave HUB_URL empty; set HUB_BIND to an address the other machines can reach (e.g. its Tailscale IP)
HUB_BIND=127.0.0.1
# Other machines: the hub's address
HUB_URL=
